@model IReadOnlyList<Kural>
@{var kural=Model.MaxBy(item=>item.Version)!;ViewData["Title"]=kural.KuralKodu;var next=new DateTime(DateTime.Today.Year,DateTime.Today.Month,1).AddMonths(1);}
<a class="back-link" asp-action="Index">← Kural kataloğu</a><div class="page-heading"><div><span class="eyebrow">@kural.KuralKodu · VERSİYON @kural.Version</span><h1>@kural.Name</h1><p>@kural.Description</p></div></div><div class="dashboard-grid"><section class="surface padded"><h2>Yeni versiyon</h2><p>Önceki versiyonlar ve bulgular korunur.</p><form asp-action="Version" method="post" class="edit-grid"><input name="KuralKodu" type="hidden" value="@kural.KuralKodu"/><input name="ExpectedVersion" type="hidden" value="@kural.Version"/><label>Önem düzeyi<select class="form-select" name="Severity">@foreach(var severity in Enum.GetValues<Severity>()){<option value="@((int)severity)" selected="@(severity==kural.Severity)">@severity.ToDisplayName()</option>}</select></label><label>Ağırlık<input type="number" name="Agirlik" class="form-control" min="1" max="100" value="@kural.Agirlik" required/></label><label>Yürürlük başlangıcı<input type="date" name="StartedAt" class="form-control" value="@next.ToString("yyyy-MM-dd")" required/></label><label>Durum<select name="IsActive" class="form-select"><option value="true">Aktif</option><option value="false">Pasif</option></select></label><label class="wide">Parametreler (JSON)<textarea name="ParametersJson" class="form-control code-field" required>@kural.ParametersJson</textarea></label><label class="wide">Değişiklik gerekçesi<textarea name="Gerekce" class="form-control" minlength="10" maxlength="1000" required></textarea></label><button class="btn btn-primary">Yeni versiyonu kaydet</button></form></section><section class="surface padded"><h2>Geçmiş dönem simülasyonu</h2><p>Seçilen parametrelerle oluşabilecek bulgu ve risk tutarını hesaplayın. Kayıtlar değişmez.</p><form asp-action="Simulation" method="post"><input name="KuralKodu" type="hidden" value="@kural.KuralKodu"/><input name="Agirlik" type="hidden" value="@kural.Agirlik"/><input name="Severity" type="hidden" value="@((int)kural.Severity)"/><label>Dönem<input class="form-control" type="number" name="donem" value="@(DateTime.Today.AddMonths(-1).Year*100+DateTime.Today.AddMonths(-1).Month)" required/></label><label>Parametreler (JSON)<textarea class="form-control code-field" name="ParametersJson" required>@kural.ParametersJson</textarea></label><button class="btn btn-primary mt-3">Simülasyonu çalıştır</button></form><hr/><h3>Kural gerekçesi</h3><p>@kural.Gerekce</p><h3>Önerilen aksiyon</h3><p>@kural.OnerilenAksiyon</p></section></div><section class="surface mt-4" tabindex="0"><div class="section-heading"><h2>Versiyon geçmişi</h2></div><table class="table table-bordered table-striped table-hover data-table"><thead><tr><th>Versiyon</th><th>Başlangıç</th><th>Bitiş</th><th>Ağırlık</th><th>Parametreler</th></tr></thead><tbody>@foreach(var ruleVersion in Model){<tr><td>v@(ruleVersion.Version)</td><td>@ruleVersion.YururlukBaslangic.ToString("dd.MM.yyyy")</td><td>@(ruleVersion.YururlukBitis?.ToString("dd.MM.yyyy")??"Açık")</td><td>@ruleVersion.Agirlik</td><td><code>@ruleVersion.ParametersJson</code></td></tr>}</tbody></table></section>
