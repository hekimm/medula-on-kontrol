@model IReadOnlyList<Kural>
@{ViewData["Title"]="Kural kataloğu";var son=Model.GroupBy(item=>item.KuralKodu).Select(g=>g.MaxBy(item=>item.Version)!).ToList();}
<a class="btn btn-light mb-3" asp-action="Calibration">Red verileriyle kalibrasyon</a>
<div class="page-heading"><div><h1>Kural kataloğu</h1><p>Kural tanımları, yürürlük tarihleri ve versiyon bilgileri.</p></div><span class="subtle-badge">@son.Count KURAL · @Model.Count VERSİYON</span></div><div class="alert alert-info">Kurallar ve fiyatlar temsili portföy verisidir; resmî SUT mevzuatı yerine geçmez.</div><section class="surface table-surface" tabindex="0"><table class="table table-bordered table-striped table-hover data-table"><thead><tr><th>Kod</th><th>Kural</th><th>Önem</th><th>Ağırlık</th><th>Versiyon</th><th>Yürürlük</th><th>Durum</th></tr></thead><tbody>@foreach(var kural in son){<tr><td><a class="record-link" asp-action="Details" asp-route-id="@kural.KuralKodu">@kural.KuralKodu</a></td><td>@kural.Name</td><td><span class="severity-badge">@kural.Severity.ToDisplayName()</span></td><td>@kural.Agirlik</td><td>v@(kural.Version)</td><td>@kural.YururlukBaslangic.ToString("dd.MM.yyyy")</td><td>@(kural.IsActive?"Aktif":"Pasif")</td></tr>}</tbody></table></section>
