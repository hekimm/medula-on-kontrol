@model PagedResult<DenetimIzi>
@{ViewData["Title"]="Denetim izi";DenetimFilter filter=ViewBag.Filter;}
<div class="page-heading"><div><h1>Denetim izi</h1><p>Kullanıcı işlemleri ve kayıt değişikliklerinin sorgulanması.</p></div><span class="subtle-badge">Salt okunur</span></div><form method="get" class="surface filter-grid"><label>Başlangıç<input class="form-control" type="date" name="StartedAt" value="@filter.StartedAt?.ToString("yyyy-MM-dd")"/></label><label>Bitiş<input class="form-control" type="date" name="FinishedAt" value="@filter.FinishedAt?.ToString("yyyy-MM-dd")"/></label><label>Kullanıcı ID<input class="form-control" type="number" name="UserId" value="@filter.UserId"/></label><label>İşlem<select class="form-select" name="Operation"><option value="">Tümü</option>@foreach(var t in Enum.GetValues<DenetimIslem>()){<option value="@((int)t)" selected="@(filter.Operation==t)">@t.ToDisplayName()</option>}</select></label><label>Varlık adı<input class="form-control" name="Varlik" value="@filter.Varlik" placeholder="FATURA_DUZELTME"/></label><button class="btn btn-primary align-self-end">Filtrele</button></form><section class="surface table-surface"><div class="table-responsive"><table class="table table-bordered table-striped table-hover data-table"><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>İşlem</th><th>Varlık</th><th>Kayıt</th><th>Değişiklik</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td class="text-nowrap">@i.KayitTarihi.TurkiyeSaatineCevir().ToString("dd.MM.yyyy HH:mm:ss")</td><td>#@i.UserId</td><td><span class="subtle-badge">@i.OperationType.ToDisplayName()</span></td><td>@i.EntityName</td><td>@i.EntityId</td><td><details><summary>Detay</summary><strong>Önce</strong><pre>@(i.PreviousValueJson??"—")</pre><strong>Sonra</strong><pre>@(i.NewValueJson??"—")</pre><small>IP: @i.IpAddress</small></details></td></tr>}</tbody></table></div><nav class="pagination-row" aria-label="Denetim sayfaları"><span>@Model.TotalCount.ToString("N0") kayıt · Sayfa @Model.PageNumber</span><div>@if(Model.PageNumber>1){<a class="btn btn-light" href="@Url.Action("Index",new{filter.StartedAt,filter.FinishedAt,filter.UserId,filter.Operation,filter.Varlik,PageNumber=Model.PageNumber-1})">Önceki</a>}@if(Model.PageNumber*Model.PageSize<Model.TotalCount){<a class="btn btn-light" href="@Url.Action("Index",new{filter.StartedAt,filter.FinishedAt,filter.UserId,filter.Operation,filter.Varlik,PageNumber=Model.PageNumber+1})">Sonraki</a>}</div></nav></section>
