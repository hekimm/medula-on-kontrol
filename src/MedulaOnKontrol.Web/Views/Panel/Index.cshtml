@model GostergePaneli
@{ViewData["Title"]="Gösterge paneli";int donem=ViewBag.Donem;IReadOnlyList<DenetimIsi> jobs=ViewBag.Jobs;}
<div class="page-heading"><div><h1>Gösterge paneli</h1><p>Fatura dönemi kontrol sonuçları ve bekleyen işlemler.</p></div><div class="heading-actions"><form method="get" class="inline-form"><label class="visually-hidden" for="donem">Fatura dönemi</label><input class="form-control period-input" type="number" min="202001" max="210012" id="donem" name="donem" value="@donem"/><button class="btn btn-light">Listele</button></form>@if((await Authorization.AuthorizeAsync(User,Yetkiler.Approve)).Succeeded){<form asp-action="ValidatePeriod" method="post"><input type="hidden" name="donem" value="@donem"/><button class="btn btn-primary">Dönemi kontrol et</button></form>}</div></div>
<div class="overview-strip"><span><span class="status-dot"></span> @donem dönemi</span><span>Temsili kural kataloğu <strong>40 kural</strong></span><a asp-controller="Fatura" asp-action="Index" asp-route-Donem="@donem">Fatura listesi</a></div>
<section class="kpi-grid" aria-label="Dönem özeti"><article class="kpi"><span class="kpi-label">TOPLAM FATURA TUTARI</span><strong>@Model.ToplamTutar.ToString("C0")</strong><span class="kpi-note">@Model.FaturaSayisi.ToString("N0") fatura bu dönemde</span></article><article class="kpi risk"><span class="kpi-label">RİSKTEKİ TUTAR</span><strong>@Model.RisktekiTutar.ToString("C0")</strong><span class="kpi-note">Engelleyici ve yüksek önem düzeyi</span></article><article class="kpi"><span class="kpi-label">ÖNCELİKLİ FATURALAR</span><strong>@Model.EngelleyiciFatura.ToString("N0") <small>fatura</small></strong><span class="kpi-note">Engelleyici bulgu içeriyor</span></article><article class="kpi"><span class="kpi-label">TAHMİNİ RİSK AZALMASI</span><strong class="teal">@Model.OnlenenTahminiTutar.ToString("C0")</strong><span class="kpi-note">İlk kontrol ve son kontrol farkı</span></article></section>
<div class="dashboard-grid"><section class="surface"><div class="section-heading"><div><h2>Klinik bazında risk</h2><p>Riskteki tutarın kliniklere dağılımı</p></div><span class="subtle-badge">TÜRK LİRASI</span></div><div id="clinic-chart" class="chart" data-labels="@System.Text.Json.JsonSerializer.Serialize(Model.Klinikler.Select(item=>item.Name))" data-values="@System.Text.Json.JsonSerializer.Serialize(Model.Klinikler.Select(item=>item.Tutar))"></div><details class="chart-data"><summary>Grafiği tablo olarak görüntüle</summary><table class="table"><thead><tr><th>Klinik</th><th>Riskteki tutar</th></tr></thead><tbody>@foreach(var klinik in Model.Klinikler){<tr><td>@klinik.Name</td><td>@klinik.Tutar.ToString("C2")</td></tr>}</tbody></table></details></section>
<section class="surface"><div class="section-heading"><div><h2>En sık bulgular</h2><p>Güncel kontrollerdeki ilk 10 kural</p></div></div>@if(Model.Bulgular.Count==0){<div class="empty-state"><h3>Henüz açık bulgu yok</h3><p>Dönem kontrolü tamamlandığında sonuçlar burada görünür.</p></div>}else{<ol class="bulgu-ranking" tabindex="0" aria-label="En sık bulgular">@foreach(var bulguOzeti in Model.Bulgular){<li><span class="rank-code">@bulguOzeti.Name</span><span class="rank-track"><span style="width:@((bulguOzeti.Adet*100/Math.Max(1,Model.Bulgular.Max(item=>item.Adet))).ToString(CultureInfo.InvariantCulture))%"></span></span><strong>@bulguOzeti.Adet</strong></li>}</ol>}</section></div>
<div class="dashboard-grid lower"><section class="surface"><div class="section-heading"><div><h2>Red oranı eğilimi</h2><p>Son 6 dönemde sonuçlanan gönderimler</p></div><span class="subtle-badge">SİMÜLATÖR + GERİ BESLEME</span></div><div id="trend-chart" class="chart short" data-labels="@System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(item=>item.Donem.ToString()))" data-values="@System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(item=>item.SubmittedCount==0?(decimal?)null:decimal.Round(100m*item.RejectedCount/item.SubmittedCount,2)))"></div><details class="chart-data"><summary>Grafiği tablo olarak görüntüle</summary><table class="table"><thead><tr><th>Dönem</th><th>Gönderilen</th><th>Reddedilen</th></tr></thead><tbody>@foreach(var periodTrend in Model.Trend){<tr><td>@periodTrend.Donem</td><td>@periodTrend.SubmittedCount</td><td>@periodTrend.RejectedCount</td></tr>}</tbody></table></details><p class="chart-note">Gönderim olmayan dönemlerde oran hesaplanmaz.</p></section><section class="surface"><div class="section-heading"><div><h2>Dönem kontrol işleri</h2><p>Size ait son kontrol çalışmaları</p></div></div><div id="job-list" data-active="@(jobs.Any(item=>item.Status is "BEKLIYOR" or "CALISIYOR")?"true":"false")">@if(jobs.Count==0){<p class="muted p-3">Dönem kontrolü başlatıldığında ilerleme burada görünür.</p>}@foreach(var job in jobs.Take(4)){<div class="job"><div><strong>@job.Donem dönemi</strong><span class="subtle-badge">@job.Status</span></div><progress max="@Math.Max(1,job.TotalCount)" value="@job.CompletedCount" aria-label="@job.Donem dönemi kontrol ilerlemesi"></progress><small>@job.CompletedCount / @job.TotalCount fatura · @job.FailedCount başarısız @job.Error</small></div>}</div></section></div>
