@model FaturaDenetimBaglami
@{ViewData["Title"]=Model.Fatura.FaturaNo;IReadOnlyList<Bulgu> bulgular=ViewBag.Bulgular;var canEdit=(await Authorization.AuthorizeAsync(User,Yetkiler.Correct)).Succeeded;var canApprove=(await Authorization.AuthorizeAsync(User,Yetkiler.Approve)).Succeeded;}
<a class="back-link" asp-action="Index" asp-route-Donem="@Model.Fatura.Donem">← Fatura listesi</a><div class="page-heading"><div><span class="eyebrow">FATURA DETAYI · @Model.Fatura.Donem</span><h1>@Model.Fatura.FaturaNo</h1><p>@Model.Basvuru.KlinikKodu · @Model.Basvuru.BasvuruTip.ToDisplayName() · Revizyon @Model.Fatura.Revision</p></div><div class="heading-actions">@if((await Authorization.AuthorizeAsync(User,Yetkiler.Validate)).Succeeded){<form asp-action="Validate" method="post"><input name="id" type="hidden" value="@Model.Fatura.Id"/><button class="btn btn-primary">Kontrol et</button></form>}<span class="subtle-badge">@Model.Fatura.Status.ToDisplayName()</span></div></div>
<div class="hasta-strip"><div><span class="muted">Hasta kaydı</span><strong>@Model.Hasta.HastaNo · @(ViewBag.Name ?? "S•••••• H••••")</strong></div><div><span class="muted">Kimlik numarası</span><strong>@(ViewBag.RevealIdentity ?? "0••••••••••")</strong></div><div><span class="muted">Başvuru takibi</span><strong>@Model.Basvuru.TakipNo</strong></div><div><span class="muted">Provizyon</span><strong>@(Model.Basvuru.ProvizyonNo ?? "Eksik")</strong></div>@if((await Authorization.AuthorizeAsync(User,Yetkiler.RevealIdentity)).Succeeded){<form asp-action="RevealIdentity" method="post"><input name="id" type="hidden" value="@Model.Fatura.Id"/><button class="btn btn-light btn-sm">Maskeyi kaldır</button></form>}</div>
<div class="detail-summary"><span>Toplam <strong>@Model.Fatura.ToplamTutar.ToString("C2")</strong></span><span>Riskteki tutar <strong class="risk-text">@Model.Fatura.RisktekiTutar.ToString("C2")</strong></span><span>Risk skoru <strong>@Model.Fatura.RiskSkoru.ToString("N0") / 100</strong></span><span>Son kontrol <strong>@(Model.Fatura.SonKontrolTarihi?.TurkiyeSaatineCevir().ToString("dd.MM.yyyy HH:mm") ?? "Yapılmadı")</strong></span></div>
@if(Model.Fatura.KontrolRevizyon!=Model.Fatura.Revision){<div class="alert alert-warning">Bu revizyon için güncel kontrol bulunmuyor. Görünen skor önceki kontrole ait olabilir.</div>}
<div class="detail-grid"><section class="surface"><div class="section-heading"><div><h2>Fatura kalemleri</h2><p>@Model.Kalemler.Count hizmet kaydı</p></div></div><div class="table-responsive"><table class="table table-bordered table-striped table-hover data-table"><thead><tr><th>İşlem</th><th>Tarih</th><th>Adet</th><th class="text-end">Tutar</th><th>İşlem</th></tr></thead><tbody>@foreach(var faturaKalemi in Model.Kalemler){<tr id="fatura-line-@faturaKalemi.Id" tabindex="-1"><td><strong>@faturaKalemi.SutIslemKodu</strong><small class="block muted">#@faturaKalemi.Id @(faturaKalemi.PaketKalemMi?"· Paket içi":"")</small></td><td>@faturaKalemi.IslemTarihi.ToString("dd.MM.yyyy")</td><td>@faturaKalemi.Adet.ToString("N0")</td><td class="text-end money">@faturaKalemi.Tutar.ToString("C2")</td><td>@if(canEdit){<button class="btn btn-light btn-sm" data-bs-toggle="collapse" data-bs-target="#duzelt-@faturaKalemi.Id" aria-expanded="false" aria-controls="duzelt-@faturaKalemi.Id">Düzelt</button>}</td></tr>@if(canEdit){<tr class="collapse" id="duzelt-@faturaKalemi.Id"><td colspan="5"><form asp-action="Correct" method="post" class="edit-grid"><input type="hidden" name="FaturaId" value="@Model.Fatura.Id"/><input type="hidden" name="Revision" value="@Model.Fatura.Revision"/><input type="hidden" name="KalemId" value="@faturaKalemi.Id"/><input type="hidden" name="Kind" value="line"/><label>İşlem kodu<input class="form-control" name="Code" value="@faturaKalemi.SutIslemKodu" required/></label><label>Hizmet tarihi<input class="form-control" type="date" name="KayitTarihi" value="@faturaKalemi.IslemTarihi.ToString("yyyy-MM-dd")" required/></label><label>Adet<input class="form-control" type="number" name="Adet" value="@faturaKalemi.Adet.ToString(CultureInfo.InvariantCulture)" min="1" step="1" required/></label><label>Birim fiyat<input class="form-control" type="number" name="BirimFiyat" value="@faturaKalemi.BirimFiyat.ToString(CultureInfo.InvariantCulture)" min="0" step="0.01" required/></label><label><input type="checkbox" name="PaketMi" value="true" checked="@faturaKalemi.PaketKalemMi"/> Paket kapsamında, ayrıca ücret yok</label><label><input type="checkbox" name="IsConditionSatisfied" value="true" checked="@faturaKalemi.OdemeKosuluSaglandiMi"/> Ödeme koşulu belgelendi</label><label class="wide">Düzeltme gerekçesi<textarea class="form-control" name="Gerekce" required minlength="10" maxlength="1000"></textarea></label><button class="btn btn-primary">Düzeltmeyi kaydet</button></form></td></tr>}}</tbody></table></div>
<div class="section-heading border-top"><div><h2>Başvuru kayıtları</h2><p>Mevcut klinik belgelerle doğrulayın.</p></div></div><div class="record-section"><h3>Tanılar</h3>@foreach(var tani in Model.Tanilar){<span class="subtle-badge me-2">@tani.Icd10Kod · @tani.TaniTip.ToDisplayName()</span>}@if(Model.Tanilar.Count==0){<p class="muted">Tanı kaydı bulunmuyor.</p>}<h3 class="mt-4">Belgeler</h3>@foreach(var belge in Model.Belgeler){<p>@belge.BelgeTip.ToDisplayName() · @belge.BelgeTarihi.ToString("dd.MM.yyyy") <span class="subtle-badge">@belge.ImzaDurum.ToDisplayName()</span></p>}@if(Model.Belgeler.Count==0){<p class="muted">Belge kaydı bulunmuyor.</p>}</div>
@if(canEdit){<details class="record-section border-top"><summary>Başvuru kaydını tamamla</summary><form asp-action="Correct" method="post" class="edit-grid mt-3"><input type="hidden" name="FaturaId" value="@Model.Fatura.Id"/><input type="hidden" name="Revision" value="@Model.Fatura.Revision"/><label>İşlem türü<select class="form-select" name="Kind"><option value="tani">Ana tanı kaydını doğrula</option><option value="authorization">Provizyon numarasını tamamla</option><option value="doc">Sentetik belge kaydı ekle</option><option value="total">Fatura toplamını yeniden hesapla</option></select></label><label>Tanı kodu / Provizyon no<input name="Code" class="form-control" maxlength="60"/></label><label>Belge türü<select class="form-select" name="BelgeTip" asp-items="Html.GetEnumSelectList<BelgeTip>()"></select></label><label>Belge tarihi<input class="form-control" type="date" name="KayitTarihi" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label>Geçerlilik bitişi<input class="form-control" type="date" name="GecerlilikBitis"/></label><label>İmza durumu<select class="form-select" name="Signature" asp-items="Html.GetEnumSelectList<ImzaDurum>()"></select></label><label class="wide">Gerekçe<textarea class="form-control" name="Gerekce" required minlength="10" maxlength="1000"></textarea></label><button class="btn btn-primary">Kaydı tamamla</button></form></details>}
</section><aside class="bulgular-panel"><div class="section-heading"><div><h2>Kontrol bulguları <span class="count-badge">@bulgular.Count</span></h2><p>İlgili kalemi vurgulamak için bulguya tıklayın.</p></div></div>@if(bulgular.Count==0){<div class="surface empty-state"><h3>Listelenecek bulgu yok</h3><p>Güncel sonucu görmek için kontrolü çalıştırın.</p></div>}@foreach(var bulgu in bulgular){<article class="bulgu-card severity-@((int)bulgu.Severity)"><div class="bulgu-top"><span class="severity-badge">@bulgu.Severity.ToDisplayName()</span><span>@bulgu.KuralKodu · v@(bulgu.KuralVersiyon)</span></div><h3>@if(bulgu.FaturaKalemiId.HasValue){<button class="bulgu-link" data-fatura-line="@bulgu.FaturaKalemiId">@bulgu.Message</button>}else{@bulgu.Message}</h3><p>@bulgu.Gerekce</p><div class="action-note"><strong>Önerilen aksiyon</strong><p>@bulgu.OnerilenAksiyon</p></div><div class="bulgu-bottom"><strong>@bulgu.EtkilenenTutar.ToString("C2")</strong><span>@bulgu.Status.ToDisplayName()</span></div>@if(canApprove && bulgu.Status==BulguDurum.Acik){<button type="button" class="btn btn-light btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#istisna-@bulgu.Id">Gerekçeli istisna tanımla</button>
<div class="modal fade" id="istisna-@bulgu.Id" tabindex="-1" aria-labelledby="istisna-baslik-@bulgu.Id" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="istisna-baslik-@bulgu.Id">@bulgu.KuralKodu için gerekçeli istisna</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
    <div class="modal-body"><p>İstisna bu fatura revizyonu ve kural sürümüyle sınırlıdır. Kaydettikten sonra yeniden kontrol edin.</p><form asp-action="AddException" method="post"><input type="hidden" name="FaturaId" value="@Model.Fatura.Id"/><input type="hidden" name="BulguId" value="@bulgu.Id"/><label>Gerekçe<textarea name="Gerekce" class="form-control" required minlength="10" maxlength="1000"></textarea></label><label>Geçerlilik bitişi<input type="date" name="GecerlilikBitis" class="form-control" required min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(90).ToString("yyyy-MM-dd")"/></label><button class="btn btn-light mt-2">İstisnayı kaydet</button></form></div>
  </div></div>
</div>}</article>}
@if(canApprove){<section class="surface approval-box"><h2>Onay ve gönderim</h2><p>Engelleyici bulgular çözüldükten sonra onaylayın.</p><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Fatura.Id"/><label for="approval-password">Simüle e-imza için hesap parolanız</label><input id="approval-password" name="password" type="password" class="form-control" autocomplete="current-password" required/><button class="btn btn-primary mt-2">Doğrula ve onayla</button></form><form asp-action="Submit" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Fatura.Id"/><button class="btn btn-light">MEDULA simülatörüne gönder</button></form></section>}</aside></div>
