@model PagedResult<Fatura>
@{ViewData["Title"]="Faturalar";FaturaFilter filter=ViewBag.Filter;IReadOnlyList<OzetSatiri> klinikler=ViewBag.Klinikler;}
<div class="page-heading"><div><h1>Faturalar</h1><p>Fatura sorgulama ve ön kontrol işlemleri.</p></div><span class="subtle-badge">@Model.TotalCount.ToString("N0") KAYIT</span></div>
<form method="get" class="surface filter-grid"><div><label for="donem">Dönem</label><input class="form-control" type="number" name="Donem" id="donem" value="@filter.Donem" placeholder="202609"/></div><div><label for="klinik">Klinik</label><select class="form-select" name="Klinik" id="klinik"><option value="">Tüm yetkili klinikler</option>@foreach(var klinik in klinikler){<option value="@klinik.Name" selected="@(filter.Klinik==klinik.Name)">@klinik.Name</option>}</select></div><div><label for="basvuru-tip">Başvuru tipi</label><select class="form-select" name="BasvuruTip" id="basvuru-tip"><option value="">Tümü</option>@foreach(var basvuruTipi in Enum.GetValues<BasvuruTip>()){<option value="@((int)basvuruTipi)" selected="@(filter.BasvuruTip==basvuruTipi)">@basvuruTipi.ToDisplayName()</option>}</select></div><div><label for="status">Durum</label><select class="form-select" name="Status" id="status"><option value="">Tümü</option>@foreach(var faturaDurum in Enum.GetValues<FaturaDurum>()){<option value="@((int)faturaDurum)" selected="@(filter.Status==faturaDurum)">@faturaDurum.ToDisplayName()</option>}</select></div><div><label for="risk-min">En düşük risk</label><input class="form-control" type="number" name="RiskMin" id="risk-min" value="@filter.RiskMin" min="0" max="100"/></div><div><label for="risk-max">En yüksek risk</label><input class="form-control" type="number" name="RiskMax" id="risk-max" value="@filter.RiskMax" min="0" max="100"/></div><div><label for="sort-by">Sıralama</label><select class="form-select" name="SortBy" id="sort-by"><option value="risk" selected="@(filter.SortBy=="risk")">Risk skoru</option><option value="amount" selected="@(filter.SortBy=="amount")">Tutar</option><option value="invoiceNumber" selected="@(filter.SortBy=="invoiceNumber")">Fatura no</option></select></div><div><label for="sort-direction">Yön</label><select name="SortDirection" id="sort-direction" class="form-select"><option value="descending" selected="@(filter.SortDirection=="descending")">Azalan</option><option value="ascending" selected="@(filter.SortDirection=="ascending")">Artan</option></select></div><button class="btn btn-primary align-self-end">Filtrele</button><a class="btn btn-light align-self-end" asp-action="Index">Temizle</a></form>
<section class="surface table-surface"><div class="table-responsive"><table class="table table-bordered table-striped table-hover data-table"><thead><tr><th>Fatura / Hasta no</th><th>Klinik</th><th>Dönem</th><th>Durum</th><th class="text-end">Tutar</th><th class="text-end">Riskteki tutar</th><th>Risk skoru</th><th>İşlem</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><a class="record-link" asp-action="Details" asp-route-id="@item.Id">@item.FaturaNo</a><small class="block muted">@item.HastaNo</small></td><td>@item.KlinikKodu<small class="block muted">@item.BasvuruTip.ToDisplayName()</small></td><td>@item.Donem</td><td><span class="subtle-badge">@item.Status.ToDisplayName()</span></td><td class="text-end money">@item.ToplamTutar.ToString("C2")</td><td class="text-end money risk-text">@item.RisktekiTutar.ToString("C2")</td><td><span class="risk-score @(item.RiskSkoru>=70?"high":item.RiskSkoru>0?"medium":"low")">@item.RiskSkoru.ToString("N0")</span></td><td><a asp-action="Details" asp-route-id="@item.Id" aria-label="@item.FaturaNo ayrıntısını aç" class="btn btn-light btn-sm">Detay</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="8" class="empty-state">Bu filtrelere uygun fatura bulunamadı.</td></tr>}</tbody></table></div><nav class="pagination-row" aria-label="Fatura sayfaları"><span>Sayfa @Model.PageNumber · @Model.TotalCount kayıt</span><div>@if(Model.PageNumber>1){<a class="btn btn-light" href="@Url.Action("Index",new{filter.Donem,filter.Klinik,filter.BasvuruTip,filter.Status,filter.RiskMin,filter.RiskMax,filter.SortBy,filter.SortDirection,PageNumber=Model.PageNumber-1})">Önceki</a>}@if(Model.PageNumber*Model.PageSize<Model.TotalCount){<a class="btn btn-light" href="@Url.Action("Index",new{filter.Donem,filter.Klinik,filter.BasvuruTip,filter.Status,filter.RiskMin,filter.RiskMax,filter.SortBy,filter.SortDirection,PageNumber=Model.PageNumber+1})">Sonraki</a>}</div></nav></section>
